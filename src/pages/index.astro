---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { entryPath, isSectionIndex } from '../lib/routes';
const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).filter((p) => !p.data.sectionIndex && p.id.split('/').length > 1 && !isSectionIndex(p.id)).sort((a,b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)).slice(0, 6);
---
<Base><section class="hero shell"><div class="hero-copy"><p class="eyebrow">FIELD NOTES / 2026</p><h1>把复杂的<br><em>全球网络</em>讲清楚。</h1><p class="hero-lede">从客户端配置到晚高峰线路实测，记录可复现、可验证的网络解决方案。</p><a class="button button-primary" href="/docs/">浏览教程 →</a></div><div class="hero-visual"><div class="signal-card"><strong>NETWORK STATUS</strong><b>STABLE</b><p>IPLC / IEPL · 24/7 Monitoring</p><p>Avg latency · 38ms</p></div></div></section><section class="section shell"><div class="section-heading"><div><p class="eyebrow">EXPLORE THE LAB</p><h2>从这里开始</h2></div></div><div class="topic-grid">{[['01','文章科普','协议、分流与网络机制','/articles/'],['02','教程知识库','Clash、Shadowrocket、Sing-box','/docs/'],['03','机场推荐','指标、线路与晚高峰观察','/recommend/'],['04','故障 FAQ','从现象定位网络问题','/faq/']].map(([n,t,d,u]) => <a class="topic-card" href={u}><span>{n}</span><div><h3>{t}</h3><p>{d}</p></div><b>↗</b></a>)}</div></section><section class="section section-muted"><div class="shell"><div class="section-heading"><h2>最新记录</h2><a class="text-link" href="/articles/">全部文章 →</a></div><div class="post-grid">{posts.map((post) => <article class="post-card"><div class="post-meta"><span>{post.id.split('/')[0].toUpperCase()}</span><time>{post.data.date?.toISOString().slice(0,10)}</time></div><h3><a href={`/${entryPath(post)}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="read-more" href={`/${entryPath(post)}/`}>阅读记录 ↗</a></article>)}</div></div></section></Base>
