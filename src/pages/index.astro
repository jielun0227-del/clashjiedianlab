---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { entryPath, isSectionIndex } from '../lib/routes';
import { airports } from '../data/airports';
const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).filter((p) => !p.data.sectionIndex && p.id.split('/').length > 1 && !isSectionIndex(p.id)).sort((a,b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)).slice(0, 6);
---
<Base><section class="hero shell"><div class="hero-copy"><p class="eyebrow">FIELD NOTES / 2026</p><h1>把复杂的<br><em>全球网络</em>讲清楚。</h1><p class="hero-lede">从客户端配置到晚高峰线路实测，记录可复现、可验证的网络解决方案。</p><a class="button button-primary" href="/recommend/">浏览机场榜 →</a></div><div class="hero-visual"><div class="signal-card"><strong>NETWORK STATUS</strong><b>STABLE</b><p>IPLC / IEPL · 24/7 Monitoring</p><p>Avg latency · 38ms</p></div></div></section><section class="section shell"><div class="section-heading"><div><p class="eyebrow">AIRPORT DIRECTORY / 2026</p><h2>机场板块</h2></div><a class="text-link" href="/recommend/">查看完整榜单 →</a></div><div class="airport-grid">{airports.map((airport, index) => <article class="airport-card"><div class="post-meta"><span>TOP {(index + 1).toString().padStart(2, '0')}</span><span>FIELD LISTING</span></div><h3>{airport.name}</h3><p>{airport.tagline}</p><dl><dt>线路</dt><dd>{airport.route}</dd><dt>客户端</dt><dd>{airport.clients}</dd></dl><div class="airport-actions"><a class="read-more" href={`/airports/${airport.slug}/`}>查看板块 ↗</a><a class="button button-primary" href={airport.link} target="_blank" rel="sponsored noopener noreferrer">前往官网</a></div></article>)}</div></section><section class="section section-muted"><div class="shell"><div class="section-heading"><h2>最新记录</h2><a class="text-link" href="/articles/">全部文章 →</a></div><div class="post-grid">{posts.map((post) => <article class="post-card"><div class="post-meta"><span>{post.id.split('/')[0].toUpperCase()}</span><time>{post.data.date?.toISOString().slice(0,10)}</time></div><h3><a href={`/${entryPath(post)}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="read-more" href={`/${entryPath(post)}/`}>阅读记录 ↗</a></article>)}</div></div></section></Base>
