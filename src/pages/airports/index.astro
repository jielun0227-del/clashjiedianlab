---
import Base from '../../layouts/Base.astro';
import { airports } from '../../data/airports';
---
<Base title="机场板块 · 极客网络实验室" description="主流机场服务商独立板块与外部入口索引。"><section class="page-intro shell"><p class="eyebrow">AIRPORT DIRECTORY</p><h1>机场板块</h1><p>每个服务商拥有独立详细测评页。价格因套餐、活动和时间变化，推荐进入官方入口核验，不把推广链接等同于独立测评结论。</p></section><section class="section shell"><div class="airport-grid">{airports.map((airport, index) => <article class="airport-card"><div class="post-meta"><span>TOP {(index + 1).toString().padStart(2, '0')}</span><span>DIRECTORY</span></div><h2>{airport.name}</h2><p>{airport.tagline}</p><dl><dt>线路</dt><dd>{airport.route}</dd><dt>客户端</dt><dd>{airport.clients}</dd><dt>价格</dt><dd>进入官网核验</dd></dl><div class="airport-actions"><a class="read-more" href={`/airports/${airport.slug}/`}>详细测评 ↗</a><a class="button button-primary" href={airport.link} target="_blank" rel="sponsored noopener noreferrer">官网入口</a></div></article>)}</div></section></Base>
