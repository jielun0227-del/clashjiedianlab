---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { entryPath, cleanId, isSectionIndex } from '../../lib/routes';
import { airports } from '../../data/airports';
export function getStaticPaths() {
  return ['articles','docs','recommend','faq','reviews'].map((section) => ({ params: { section } }));
}
const { section } = Astro.params;
const all = await getCollection('blog', ({ data }) => data.draft !== true);
const index = all.find((entry) => cleanId(entry.id) === `${section}/_index`);
const posts = all.filter((entry) => cleanId(entry.id).startsWith(`${section}/`) && !isSectionIndex(entry.id)).sort((a,b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
const titles = { articles:'文章科普', docs:'教程知识库', recommend:'机场推荐榜', faq:'故障 FAQ', reviews:'深度测评' };
---
<Base title={`${index?.data.title ?? titles[section]} · 极客网络实验室`} description={index?.data.description}><section class="page-intro shell"><p class="eyebrow">{section?.toUpperCase()}</p><h1>{index?.data.title ?? titles[section]}</h1><p>{index?.data.description}</p></section>{section === 'recommend' && <section class="section shell"><div class="section-heading"><div><p class="eyebrow">AIRPORT DIRECTORY / 2026</p><h2>机场信息与独立板块</h2></div><a class="text-link" href="/airports/">查看全部机场 →</a></div><div class="airport-grid">{airports.map((airport, index) => <article class="airport-card"><div class="post-meta"><span>TOP {(index + 1).toString().padStart(2, '0')}</span><span>DIRECTORY</span></div><h2>{airport.name}</h2><p>{airport.tagline}</p><dl><dt>线路</dt><dd>{airport.route}</dd><dt>客户端</dt><dd>{airport.clients}</dd><dt>最低套餐</dt><dd>{airport.price ?? '官网实时核验'}</dd></dl><div class="airport-actions"><a class="read-more" href={`/airports/${airport.slug}/`}>详细测评 ↗</a><a class="button button-primary" href={airport.link} target="_blank" rel="sponsored noopener noreferrer">官网入口</a></div></article>)}</div></section>}<section class="section shell"><div class="post-grid post-grid-wide">{posts.map((post) => <article class="post-card"><div class="post-meta"><span>{section?.toUpperCase()}</span><time>{post.data.date?.toISOString().slice(0,10)}</time></div><h2><a href={`/${entryPath(post)}/`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="read-more" href={`/${entryPath(post)}/`}>继续阅读 ↗</a></article>)}</div></section></Base>
