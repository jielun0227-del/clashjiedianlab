---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { entryPath, cleanId, isSectionIndex } from '../../lib/routes';
import { airports } from '../../data/airports';
export function getStaticPaths() {
  return ['articles','docs','recommend','faq','reviews'].map((section) => ({ params: { section } }));
}
const { section } = Astro.params;
const all = await getCollection('blog', ({ data }) => data.draft !== true);
const index = all.find((entry) => cleanId(entry.id) === `${section}/_index`);
const airportReviewIds = new Set(airports.map((airport) => `reviews/${airport.slug}-review`));
const posts = all
  .filter((entry) => cleanId(entry.id).startsWith(`${section}/`) && !isSectionIndex(entry.id))
  .filter((entry) => section !== 'reviews' || !airportReviewIds.has(cleanId(entry.id)))
  .sort((a,b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
const titles = { articles:'文章科普', docs:'教程知识库', recommend:'机场推荐榜', faq:'故障 FAQ', reviews:'深度测评' };

const sectionMeta = {
  articles: {
    title: '网络科普文章与代理协议原理解析大全 · 极客网络实验室',
    description: '深入浅出科普网络代理底层原理、常见协议优劣与流量分流机制。涵盖 VLESS、Shadowsocks、IPLC/IEPL 专线架构与跨国网络优化技巧，助你彻底搞懂网络基础知识。'
  },
  docs: {
    title: '主流代理客户端配置教程知识库与调优指南 · 极客网络实验室',
    description: '涵盖 Clash Verge Rev、Sing-box、Shadowrocket 等主流跨平台客户端图文上手指南。从订阅导入、节点切换、TUN 虚拟网卡模式到 DNS 泄露防范，手把手带你完成全流程实测配置。'
  },
  recommend: {
    title: '2026 年度稳定机场推荐排行榜 | 晚高峰专线实测 · 极客网络实验室',
    description: '基于晚高峰延迟与丢包监控，精选 2026 年度稳定靠谱的 IPLC/IEPL 专线机场。结合原生 IP 解锁、流媒体与 AI 工具访问测试，提供全方位横向综合评测对比与避坑指南。'
  },
  faq: {
    title: '机场与网络节点使用常见问题解答与故障排查 FAQ · 极客网络实验室',
    description: '汇总排查订阅导入失败、节点超时连接不上、TUN 模式无网、ChatGPT 访问报错 1020 及账号支付安全等高频故障，提供快速定位原因与可复现的解决方案。'
  },
  reviews: {
    title: '2026 机场深度测评专栏：晚高峰测速、丢包率与解锁能力实测 · 极客网络实验室',
    description: '汇集快狸、可信云、速界等多家主流机场的独立深度评测报告。公开晚高峰 4K 测速、网络抖动与丢包率、多平台客户端兼容性及价格性价比分析，提供真实中立的实测参考。'
  }
};

const currentMeta = sectionMeta[section] || {};
const pageTitle = index?.data.title && index.data.title.length > 15 ? `${index.data.title} · 极客网络实验室` : (currentMeta.title || `${titles[section]} · 极客网络实验室`);
const pageDesc = currentMeta.description || index?.data.description;
---
<Base title={pageTitle} description={pageDesc}>
  <section class="page-intro shell">
    <p class="eyebrow">{section?.toUpperCase()}</p>
    <h1>{index?.data.title ?? titles[section]}</h1>
    <p>{index?.data.description}</p>
  </section>

  {section === 'recommend' && <section class="section shell">
    <div class="section-heading"><div><p class="eyebrow">AIRPORT DIRECTORY / 2026</p><h2>机场信息与独立板块</h2></div><a class="text-link" href="/airports/">查看全部机场 →</a></div>
    <div class="airport-grid">{airports.map((airport, index) => <article class="airport-card">
      <div class="post-meta"><span>TOP {(index + 1).toString().padStart(2, '0')}</span><span>DIRECTORY</span></div>
      <h2>{airport.name}</h2><p>{airport.tagline}</p>
      <dl><dt>线路</dt><dd>{airport.route}</dd><dt>客户端</dt><dd>{airport.clients}</dd><dt>最低套餐</dt><dd>{airport.price}</dd></dl>
      <div class="airport-actions"><a class="read-more" href={`/reviews/${airport.slug}/`}>详细测评 ↗</a><a class="button button-primary" href={airport.link} target="_blank" rel="sponsored noopener noreferrer">官网入口</a></div>
    </article>)}</div>
  </section>}

  {section === 'reviews' && <section class="section shell">
    <div class="section-heading"><div><p class="eyebrow">AIRPORT REVIEWS / 2026</p><h2>机场深度测评</h2></div><a class="text-link" href="/recommend/">查看机场推荐榜 →</a></div>
    <div class="post-grid post-grid-wide">{airports.map((airport) => <article class="post-card">
      <div class="post-meta"><span>深度测评</span><time>2026-10-12</time></div>
      <h2><a href={`/reviews/${airport.slug}/`}>{airport.name}详细测评：线路、价格与使用体验</a></h2>
      <p>{airport.tagline}。当前公开最低套餐为 {airport.price}，文章包含线路、客户端兼容性、价格核验与晚高峰复测方法。</p>
      <a class="read-more" href={`/reviews/${airport.slug}/`}>阅读详细测评 ↗</a>
    </article>)}</div>
  </section>}

  {posts.length > 0 && <section class="section shell">
    <div class="post-grid post-grid-wide">{posts.map((post) => <article class="post-card">
      <div class="post-meta"><span>{section?.toUpperCase()}</span><time>{post.data.date?.toISOString().slice(0,10)}</time></div>
      <h2><a href={`/${entryPath(post)}/`}>{post.data.title}</a></h2>
      <p>{post.data.description}</p>
      <a class="read-more" href={`/${entryPath(post)}/`}>继续阅读 ↗</a>
    </article>)}</div>
  </section>}
</Base>
